generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  TEXT
  VOICE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique // the @handle: always lowercase (see cleanHandle in @cohle/shared)
  passwordHash String
  avatarUrl    String?
  avatarVersion Int      @default(0)
  emailVerifiedAt DateTime?
  tag          String?   // friend code shown as #tag next to the name (e.g. @luiz #br21)
  friendsSent  Friendship[] @relation("FriendRequester")
  friendsGot   Friendship[] @relation("FriendAddressee")
  badge        String?   // "DEV": shown next to the name (granted by the server, never chosen by the user)
  role         String    @default("USER") // USER | ADMIN | OWNER (OWNER = company master, derived from OWNER_EMAILS, never editable)
  lastSeenAt   DateTime?
  displayName  String?   // shown instead of the @username in chat and calls (1-32 chars, cleaned by cleanDisplayName)
  bio          String?   // "about me", up to 190 chars
  bannerColor  String?   // "#rrggbb" cover colour of the profile card
  notesWritten UserNote[] @relation("NoteAuthor")
  notesAbout   UserNote[] @relation("NoteTarget")
  reactions    Reaction[]
  uploads      Attachment[]
  items        UserItem[]
  equipped     UserEquipped[]
  prefs        UserPrefs?
  stats        UserStats?
  allowEmailFind Boolean @default(true) // others may find me by e-mail when adding friends
  accesses     AccessLog[]
  emailCodes   EmailCode[]
  createdAt    DateTime  @default(now())
  members      Member[]
  messages     Message[]
  bans         Ban[]
  dmSent       DirectMessage[] @relation("DmSender")
  dmReceived   DirectMessage[] @relation("DmRecipient")
}

model Server {
  id         String    @id @default(cuid())
  name       String
  inviteCode String    @unique @default(cuid())
  iconUrl    String?
  iconVersion Int     @default(0)
  createdAt  DateTime  @default(now())
  members    Member[]
  channels   Channel[]
  bans       Ban[]
  settings   ServerSetting[]
}

model Member {
  userId   String
  serverId String
  role     String @default("MEMBER")
  muted    Boolean @default(false) // owner server-muted: cannot publish audio in any call
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
}

model Channel {
  id       String      @id @default(cuid())
  serverId String
  name     String
  type     ChannelType
  server   Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  // a reply keeps a copy of what it answers, so it still reads fine after the original is erased by the 15-message limit
  replyToId     String?
  replyAuthorId String?
  replyAuthorName String?
  replyText     String?
  replyTo   Message? @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("Replies")
  reactions Reaction[]
  attachments Attachment[]
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Ban {
  serverId  String
  userId    String
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
}

// Private 1:1 messages (history is kept). Only people who share a server can start a conversation.
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  replyToId     String?
  replyAuthorId String?
  replyAuthorName String?
  replyText     String?
  replyTo     DirectMessage? @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     DirectMessage[] @relation("DmReplies")
  reactions   Reaction[]
  attachments Attachment[]
  sender      User     @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

// How far userId has read the conversation with peerId (drives the unread badges).
model DmRead {
  userId String
  peerId String
  readAt DateTime @default(now())

  @@id([userId, peerId])
}

// One-time 6-digit codes sent by e-mail (confirm the address, reset the password). Only a hash is stored.
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // VERIFY | RESET
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// Friend requests and friendships (one row per pair: who asked, who was asked, and whether it was accepted).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())
  acceptedAt  DateTime? // when the request became a friendship ("friends since")
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Who opened the app / signed in / registered, and when. No IP address is stored. Pruned after 90 days.
model AccessLog {
  id     String   @id @default(cuid())
  userId String
  kind   String   // register | login | open
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([at])
  @@index([userId, at])
}

// One row every 5 minutes while the API is awake. Used for the admin charts and to estimate the free-plan hours. Pruned after 60 days.
model MetricSample {
  at     DateTime @id @default(now())
  online Int
  voice  Int
  rssMb  Int
}

// One row per day: voice participant-minutes (what LiveKit bills), database size at the last sample.
model DailyUsage {
  day          String @id // YYYY-MM-DD (UTC)
  voiceMinutes Int    @default(0)
  dbMb         Float  @default(0)
}

// A private note about another person ("who is this?"). Only its author ever sees it.
model UserNote {
  authorId  String
  targetId  String
  text      String
  updatedAt DateTime @updatedAt
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target    User     @relation("NoteTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([authorId, targetId])
}

// One icon reaction by one person on one message (a channel message OR a direct message). Gone with its message.
model Reaction {
  id        String   @id @default(cuid())
  messageId String?
  dmId      String?
  userId    String
  key       String   // see REACTION_KEYS in @cohle/shared
  createdAt DateTime @default(now())
  message   Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  dm        DirectMessage?  @relation(fields: [dmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, key])
  @@unique([dmId, userId, key])
  @@index([messageId])
  @@index([dmId])
}

// A file or image on a message. Uploaded first (messageId and dmId empty = "pending", swept after an hour), linked when the message is sent.
// Images are re-encoded to WebP by the server (metadata and any hidden payload gone) with a small thumbnail; other files are stored as they came and only ever served as downloads.
model Attachment {
  id        String   @id @default(cuid())
  ownerId   String
  messageId String?
  dmId      String?
  name      String
  mime      String
  size      Int      // bytes of `data`
  kind      String   // "image" | "file"
  width     Int?
  height    Int?
  hasThumb  Boolean  @default(false)
  data      Bytes
  thumb     Bytes?
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message   Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  dm        DirectMessage? @relation(fields: [dmId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([messageId])
  @@index([dmId])
}

// ---- Visual-items shop (Preview Beta) ----
// A themed set (e.g. Natal). `ativo`, `inicio` and `fim` are runtime switches (edit the row, no deploy); the rest comes from the code catalog.
model Collection {
  id        String   @id @default(cuid())
  key       String   @unique
  nome      String
  descricao String   @default("")
  categoria String
  sazonal   Boolean  @default(false)
  ativo     Boolean  @default(true)
  inicio    DateTime?
  fim       DateTime?
  bonus     String?  // effect unlocked by equipping the whole set
  bannerUrl String?
  items     ShopItem[]
}

model ShopItem {
  id           String   @id @default(cuid())
  key          String   @unique
  tipo         String   // see ITEM_TYPES in @cohle/shared
  nome         String
  descricao    String   @default("")
  raridade     String   // comum | raro | epico | lendario
  categoria    String   // e.g. natal, base, politica
  assetUrl     String?
  price        Int      @default(0)   // cents, for when charging starts
  isFreeBeta   Boolean  @default(true)
  ativo        Boolean  @default(true)
  meta         Json     @default("{}")
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  owners       UserItem[]
  equippedBy   UserEquipped[]

  @@index([collectionId])
}

model UserItem {
  userId     String
  itemId     String
  source     String   @default("beta") // beta | achievement | auto
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

model UserEquipped {
  userId String
  slot   String
  itemId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
}

model ServerSetting {
  serverId String
  key      String
  value    Json
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, key])
}

model UserPrefs {
  userId        String  @id
  effectsOff    Boolean @default(false)
  soundsOff     Boolean @default(false)
  seasonalAuto  Boolean @default(true)
  hidePolitical Boolean @default(false)
  lite          String  @default("auto") // auto | on | off
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-person counters (messages are erased after 15, so achievements need their own count).
model UserStats {
  userId        String @id
  messages      Int    @default(0)
  voiceMinutes  Int    @default(0)
  longestCallMin Int   @default(0)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
