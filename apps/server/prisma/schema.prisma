generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  TEXT
  VOICE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  avatarUrl    String?
  avatarVersion Int      @default(0)
  emailVerifiedAt DateTime?
  tag          String?   // friend code shown as #tag next to the name (e.g. @luiz #br21)
  friendsSent  Friendship[] @relation("FriendRequester")
  friendsGot   Friendship[] @relation("FriendAddressee")
  badge        String?   // "DEV": shown next to the name (granted by the server, never chosen by the user)
  role         String    @default("USER") // USER | ADMIN | OWNER (OWNER = company master, derived from OWNER_EMAILS, never editable)
  lastSeenAt   DateTime?
  accesses     AccessLog[]
  emailCodes   EmailCode[]
  createdAt    DateTime  @default(now())
  members      Member[]
  messages     Message[]
  bans         Ban[]
  dmSent       DirectMessage[] @relation("DmSender")
  dmReceived   DirectMessage[] @relation("DmRecipient")
}

model Server {
  id         String    @id @default(cuid())
  name       String
  inviteCode String    @unique @default(cuid())
  iconUrl    String?
  iconVersion Int     @default(0)
  createdAt  DateTime  @default(now())
  members    Member[]
  channels   Channel[]
  bans       Ban[]
}

model Member {
  userId   String
  serverId String
  role     String @default("MEMBER")
  muted    Boolean @default(false) // owner server-muted: cannot publish audio in any call
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
}

model Channel {
  id       String      @id @default(cuid())
  serverId String
  name     String
  type     ChannelType
  server   Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Ban {
  serverId  String
  userId    String
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
}

// Private 1:1 messages (history is kept). Only people who share a server can start a conversation.
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  sender      User     @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

// How far userId has read the conversation with peerId (drives the unread badges).
model DmRead {
  userId String
  peerId String
  readAt DateTime @default(now())

  @@id([userId, peerId])
}

// One-time 6-digit codes sent by e-mail (confirm the address, reset the password). Only a hash is stored.
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // VERIFY | RESET
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// Friend requests and friendships (one row per pair: who asked, who was asked, and whether it was accepted).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Who opened the app / signed in / registered, and when. No IP address is stored. Pruned after 90 days.
model AccessLog {
  id     String   @id @default(cuid())
  userId String
  kind   String   // register | login | open
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([at])
  @@index([userId, at])
}

// One row every 5 minutes while the API is awake. Used for the admin charts and to estimate the free-plan hours. Pruned after 60 days.
model MetricSample {
  at     DateTime @id @default(now())
  online Int
  voice  Int
  rssMb  Int
}

// One row per day: voice participant-minutes (what LiveKit bills), database size at the last sample.
model DailyUsage {
  day          String @id // YYYY-MM-DD (UTC)
  voiceMinutes Int    @default(0)
  dbMb         Float  @default(0)
}
