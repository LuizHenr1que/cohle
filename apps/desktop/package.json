{
  "name": "@cohle/desktop",
  "version": "0.0.13",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "dist:mac": "VITE_TEST_LOGIN=1 pnpm --filter @cohle/client build && electron-builder --mac --arm64 --x64",
    "dist:win": "VITE_TEST_LOGIN=1 pnpm --filter @cohle/client build && electron-builder --win --x64",
    "dist:mac:prod": "pnpm --filter @cohle/client build && electron-builder --mac --arm64 --x64",
    "dist:win:prod": "pnpm --filter @cohle/client build && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.cohle.desktop",
    "productName": "Cohle",
    "files": [
      "src/**",
      "build/icon.png",
      "build/tray-*.png",
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "O Cohle usa a câmera para você aparecer nas chamadas de vídeo.",
        "NSMicrophoneUsageDescription": "O Cohle usa o microfone para você falar nas chamadas de voz."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "Cohle-${os}-${arch}.${ext}",
    "afterPack": "build/adhoc-sign.cjs",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/LuizHenr1que/cohle-releases/releases/latest/download/"
      }
    ]
  },
  "description": "Cohle - chat, voz e compartilhamento de tela",
  "author": "Cohle",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
